)


# Labels

ax.set_xlabel(
    r"Test $\delta_{13}$ (degrees)"
)

ax.set_ylabel(
    r"$\Delta\chi^2$ (normalized)"
)

ax.set_title(
    r"$\Delta\chi^2$ profiles, "
    r"4-flavor (3+1) framework"
)


# Limits

ax.set_xlim(
    -180,
    180
)

ax.set_ylim(
    -0.02,
    1.05
)


# Ticks

ax.set_xticks([
